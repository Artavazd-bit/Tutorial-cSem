% checklist for composites.

<<weights-boot>>=
# Weight estimates incl. bootstrap std. errors, t-values and p-values
summarize(res_csem_boot)$Estimates$Weight_estimates
@

\subsection{Structural model evaluation}
\label{sec:structural}

% TODO (Jason): text — lead-in: once the measurement models are established, the
% structural model can be evaluated: path coefficient estimates and their significance
% (bootstrap), effect sizes (f^2), and the coefficient of determination (R^2).

<<paths-boot>>=
# Path coefficient estimates incl. bootstrap std. errors, t-values and p-values
summarize(res_csem_boot)$Estimates$Path_estimates
@

