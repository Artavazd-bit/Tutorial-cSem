<<setup, include=FALSE>>=
library(knitr)
Sys.setenv(LANGUAGE = "en")
opts_chunk$set(
  eval       = TRUE,   # chunks are executed at knit time; results appear in the document
  echo       = TRUE,
  highlight  = TRUE,
  background = "#F8F8F8",
  size       = "small",
  comment    = NA,
  prompt     = FALSE,
  tidy       = FALSE
)

# Output hook: chunks with the option excerpt.lines = n show only each section
# headline of the printed output plus the first n lines after it; omitted lines
# are replaced by "...". Section headlines are matched by the separator style of
# cSEM's print methods ("____" frame lines and "---- title ----" lines).
local({
  hook_output <- knit_hooks$get("output")
  knit_hooks$set(output = function(x, options) {
    n <- options$excerpt.lines
    if (!is.null(n)) {
      lines <- unlist(strsplit(x, "\n"))
      sep <- grep("^_{20,}|^-+ .+ -+$", lines)
      if (length(sep) > 0) {
        keep <- sort(unique(unlist(lapply(sep, function(i) i:min(i + n, length(lines))))))
        out <- character(0)
        prev <- 0
        for (i in keep) {
          if (i > prev + 1) out <- c(out, "\t...", "")
          out <- c(out, lines[i])
          prev <- i
        }
        if (prev < length(lines)) out <- c(out, "\t...")
        x <- paste0(paste(out, collapse = "\n"), "\n")
      }
    }
    hook_output(x, options)
  })
})

# Warning hook: keep knitr's warning color, but typeset warnings like normal
# output (verbatim block inside the chunk box) instead of a wrapped text
# paragraph; lines longer than the 80-character output width are wrapped.
knit_hooks$set(warning = function(x, options) {
  x <- gsub("\n*$", "", x)
  x <- paste(unlist(lapply(strsplit(x, "\n")[[1]], strwrap, width = 80)),
             collapse = "\n")
  paste0("\\begingroup\\color{warningcolor}\\begin{verbatim}\n",
         x, "\n\\end{verbatim}\\endgroup")
})
@

\pagenumbering{gobble}


\title{Consistent Partial Least Squares: A \pkg{cSEM} tutorial}
\author{Jason J. Berger, Florian Schuberth}

\date{\today}

